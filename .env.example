# ---------------------------------------------------------------------------
# Database (Postgres). On Vercel, add a Neon/Supabase/Vercel Postgres store and
# copy both URLs here. DIRECT_URL is the non-pooled connection used by migrations.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/honchar?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/honchar?sslmode=require"

# ---------------------------------------------------------------------------
# Session signing key. Must be at least 24 characters and kept secret.
# Generate one with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-long-random-string"

# ---------------------------------------------------------------------------
# Photo uploads. Set this on Vercel (Storage -> Blob -> connect) so uploads go
# to Blob storage. Leave it unset locally and photos are written to
# public/uploads instead.
# ---------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ---------------------------------------------------------------------------
# Optional: credentials created by `npm run db:seed` for the first owner login.
# ---------------------------------------------------------------------------
# SEED_ADMIN_EMAIL="owner@honcharauto.com"
# SEED_ADMIN_PASSWORD="change-me"
